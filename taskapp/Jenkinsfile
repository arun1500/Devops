pipeline {
    agent any

    environment {
        NETWORK  = "taskflow-network"
        DB_NAME  = "taskapp"
        DB_USER  = "taskuser"
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Database') {
            steps {
                withCredentials([string(credentialsId: 'taskflow-db-password', variable: 'DB_PASSWORD')]) {
                    sh '''
                        docker build -t taskflow-db:latest ./taskapp/db
                        docker rm -f taskflow-db 2>/dev/null || true

                        docker run -d --name taskflow-db --network ${NETWORK} \
                            -e POSTGRES_DB=${DB_NAME} \
                            -e POSTGRES_USER=${DB_USER} \
                            -e POSTGRES_PASSWORD="$DB_PASSWORD" \
                            -v taskflow-db-data:/var/lib/postgresql \
                            taskflow-db:latest
                    '''
                }
            }
        }

        stage('Backend') {
            steps {
                withCredentials([string(credentialsId: 'taskflow-db-password', variable: 'DB_PASSWORD')]) {
                    sh '''
                        docker build -t taskflow-backend:latest ./taskapp/backend
                        docker rm -f taskflow-backend 2>/dev/null || true

                        docker run -d --name taskflow-backend --network ${NETWORK} -p 4000:4000 \
                            -e PORT=4000 \
                            -e DB_HOST=taskflow-db \
                            -e DB_PORT=5432 \
                            -e DB_NAME=${DB_NAME} \
                            -e DB_USER=${DB_USER} \
                            -e DB_PASSWORD="$DB_PASSWORD" \
                            taskflow-backend:latest
                    '''
                }
            }
        }

        stage('Frontend') {
            steps {
                sh '''
                    docker build -t taskflow-frontend:latest ./taskapp/frontend
                    docker rm -f taskflow-frontend 2>/dev/null || true

                    docker run -d --name taskflow-frontend -p 3000:80 taskflow-frontend:latest
                '''
            }
        }
    }
}
